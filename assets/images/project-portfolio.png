<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#090d16" />
      <stop offset="50%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#1e1b4b" />
    </linearGradient>
    <linearGradient id="cyanIndigo" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#06b6d4" />
      <stop offset="100%" stop-color="#6366f1" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background -->
  <rect width="800" height="500" fill="url(#bgGrad)" />

  <!-- Grid Lines -->
  <g stroke="rgba(255,255,255,0.05)" stroke-width="1">
    <line x1="100" y1="0" x2="100" y2="500" />
    <line x1="200" y1="0" x2="200" y2="500" />
    <line x1="300" y1="0" x2="300" y2="500" />
    <line x1="400" y1="0" x2="400" y2="500" />
    <line x1="500" y1="0" x2="500" y2="500" />
    <line x1="600" y1="0" x2="600" y2="500" />
    <line x1="700" y1="0" x2="700" y2="500" />
    <line x1="0" y1="100" x2="800" y2="100" />
    <line x1="0" y1="200" x2="800" y2="200" />
    <line x1="0" y1="300" x2="800" y2="300" />
    <line x1="0" y1="400" x2="800" y2="400" />
  </g>

  <!-- Glowing Orbs -->
  <circle cx="200" cy="150" r="120" fill="#06b6d4" opacity="0.15" filter="url(#glow)" />
  <circle cx="600" cy="350" r="140" fill="#a855f7" opacity="0.12" filter="url(#glow)" />

  <!-- Browser Window Mockup -->
  <rect x="150" y="80" width="500" height="340" rx="16" fill="rgba(15, 23, 42, 0.85)" stroke="rgba(255,255,255,0.15)" stroke-width="2" />
  
  <!-- Window Header -->
  <rect x="150" y="80" width="500" height="40" rx="16" fill="#1e293b" />
  <circle cx="175" cy="100" r="6" fill="#ef4444" />
  <circle cx="195" cy="100" r="6" fill="#f59e0b" />
  <circle cx="215" cy="100" r="6" fill="#10b981" />
  <rect x="250" y="90" width="300" height="20" rx="6" fill="#0f172a" />
  <text x="400" y="104" fill="#94a3b8" font-family="'Courier New', monospace" font-size="11" text-anchor="middle">https://ayannathani.dev</text>

  <!-- Hero Content Representation -->
  <text x="400" y="180" fill="#f8fafc" font-family="'Segoe UI', Roboto, sans-serif" font-size="24" font-weight="bold" text-anchor="middle">Ayan Nathani Portfolio</text>
  <text x="400" y="210" fill="#38bdf8" font-family="'Courier New', monospace" font-size="14" text-anchor="middle">Diploma Student &amp; Web Developer</text>

  <!-- Code Card inside browser -->
  <rect x="220" y="240" width="360" height="130" rx="10" fill="#090d16" stroke="rgba(6, 182, 212, 0.4)" stroke-width="1.5" />
  <text x="240" y="270" fill="#64748b" font-family="'Courier New', monospace" font-size="12">// Modern Responsive Tech Stack</text>
  <text x="240" y="295" fill="#f43f5e" font-family="'Courier New', monospace" font-size="13">const <tspan fill="#38bdf8">skills</tspan> = [<tspan fill="#a3e635">"HTML5"</tspan>, <tspan fill="#a3e635">"CSS3"</tspan>, <tspan fill="#a3e635">"JavaScript"</tspan>];</text>
  <text x="240" y="320" fill="#f43f5e" font-family="'Courier New', monospace" font-size="13">const <tspan fill="#38bdf8">internships</tspan> = <tspan fill="#c084fc">2</tspan>;</text>
  <text x="240" y="345" fill="#f43f5e" font-family="'Courier New', monospace" font-size="13">const <tspan fill="#38bdf8">status</tspan> = <tspan fill="#a3e635">"Ready to Build"</tspan>;</text>
</svg>
